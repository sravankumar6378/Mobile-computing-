signal1 = [80, 75, 70, 65, 60]
signal2 = [50, 60, 68, 72, 78]

H = 5
serving = 1

for i in range(len(signal1)):
    if serving == 1 and signal2[i] > signal1[i] + H:
        serving = 2
    elif serving == 2 and signal1[i] > signal2[i] + H:
        serving = 1

    print("Step:", i+1, "Serving Cell:", serving)
